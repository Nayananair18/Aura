# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/realityproof

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:8082,http://localhost:8081,http://192.168.1.100:8081

# Logging — debug | info | warn | error
LOG_LEVEL=info

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000   # 15 minutes (default)
# RATE_LIMIT_MAX=100            # requests per window (default)

# Request Size — cap to prevent OOM when processing base64 images
# MAX_REQUEST_SIZE=10mb         # (default)
